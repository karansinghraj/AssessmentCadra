# Service port (Render supplies this automatically)
PORT=8000

# Model provider (OpenAI-compatible). Use your own key; never commit it.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_INPUT_USD_PER_MTOK=0.15
LLM_OUTPUT_USD_PER_MTOK=0.60
LLM_TIMEOUT_SECONDS=8
LLM_CLASSIFIER_ENABLED=true
LLM_JUDGE_ENABLED=true

# Storage and prepared data
RUN_DB_PATH=var/runs.db
DATA_BUILD_DIR=build
DATA_DIR=data
MAX_BODY_CHARS=20000

# Logging
LOG_LEVEL=INFO
